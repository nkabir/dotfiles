#!/usr/bin/env bash
# Block pushes that include private content to public remotes.

set -euo pipefail

remote_name="${1:-}"
remote_url="${2:-}"

# Allow pushes to the upstream base repo.
if [[ "$remote_name" == "upstream" ]] || [[ "$remote_url" == *"cwiq-seed/dotfiles"* ]]; then
    exit 0
fi

# Only protect public forks (adjust patterns as needed).
if [[ "$remote_url" != *"github.com"* ]]; then
    exit 0
fi

private_paths=(
    "blackbox/personal/"
    "blackbox/private_"
)

blocked=0
while read -r local_ref local_sha remote_ref remote_sha; do
    # New branch push: remote_sha is all zeros.
    if [[ "$remote_sha" =~ ^0+$ ]]; then
        range="$local_sha"
    else
        range="${remote_sha}..${local_sha}"
    fi

    if git diff --name-only "$range" | rg -q "^(blackbox/personal/|blackbox/private_)" ; then
        blocked=1
        break
    fi
done

if [[ $blocked -eq 1 ]]; then
    echo "ERROR: push includes private paths (blackbox/personal or blackbox/private_)." >&2
    echo "Push aborted. Cherry-pick only shared changes to the public fork." >&2
    exit 1
fi
